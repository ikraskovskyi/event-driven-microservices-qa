{
  "uid": "sut-overview",
  "title": "SUT overview",
  "schemaVersion": 41,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "panels": [
    { "type": "row", "title": "HTTP (/api/**)", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },
    {
      "type": "timeseries", "title": "Request rate",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "expr": "sum by (application, method, uri, status) (rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[$__rate_interval]))",
        "legendFormat": "{{application}} {{method}} {{uri}} {{status}}"
      }]
    },
    {
      "type": "timeseries", "title": "Error rate (5xx)",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "expr": "(sum by (application, method, uri) (rate(http_server_requests_seconds_count{uri=~\"/api/.*\", status=~\"5..\"}[$__rate_interval])) or sum by (application, method, uri) (rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[$__rate_interval])) * 0) / sum by (application, method, uri) (rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[$__rate_interval]))",
        "legendFormat": "{{application}} {{method}} {{uri}}"
      }]
    },
    {
      "type": "timeseries", "title": "Mean latency",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "expr": "sum by (application, method, uri) (rate(http_server_requests_seconds_sum{uri=~\"/api/.*\"}[$__rate_interval])) / sum by (application, method, uri) (rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[$__rate_interval]))",
        "legendFormat": "{{application}} {{method}} {{uri}}"
      }]
    },
    {
      "type": "timeseries", "title": "Max latency",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "expr": "max by (application, method, uri) (http_server_requests_seconds_max{uri=~\"/api/.*\"})",
        "legendFormat": "{{application}} {{method}} {{uri}}"
      }]
    },
    { "type": "row", "title": "Kafka", "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 } },
    {
      "type": "timeseries", "title": "Messages processed",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "expr": "sum by (application, result) (rate(spring_kafka_listener_seconds_count[$__rate_interval]))",
        "legendFormat": "{{application}} {{result}}"
      }]
    },
    {
      "type": "timeseries", "title": "Mean processing time",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "expr": "sum by (application) (rate(spring_kafka_listener_seconds_sum[$__rate_interval])) / sum by (application) (rate(spring_kafka_listener_seconds_count[$__rate_interval]))",
        "legendFormat": "{{application}}"
      }]
    },
    {
      "type": "timeseries", "title": "Consumer lag",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "expr": "kafka_consumergroup_lag_sum",
        "legendFormat": "{{consumergroup}} {{topic}}"
      }]
    },
    {
      "type": "timeseries", "title": "Messages produced",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset{topic!~\"__.*\"}[$__rate_interval]))",
        "legendFormat": "{{topic}}"
      }]
    },
    { "type": "row", "title": "JVM", "gridPos": { "x": 0, "y": 26, "w": 24, "h": 1 } },
    {
      "type": "timeseries", "title": "CPU",
      "gridPos": { "x": 0, "y": 27, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "expr": "process_cpu_usage{job=\"sut\"}",
        "legendFormat": "{{application}}"
      }]
    },
    {
      "type": "timeseries", "title": "Heap used",
      "gridPos": { "x": 6, "y": 27, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
        "legendFormat": "{{application}}"
      }]
    },
    {
      "type": "timeseries", "title": "GC time (share of wall time)",
      "gridPos": { "x": 12, "y": 27, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "expr": "sum by (application) (rate(jvm_gc_pause_seconds_sum[$__rate_interval]))",
        "legendFormat": "{{application}}"
      }]
    },
    {
      "type": "timeseries", "title": "Live threads",
      "gridPos": { "x": 18, "y": 27, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "expr": "jvm_threads_live_threads",
        "legendFormat": "{{application}}"
      }]
    },
    { "type": "row", "title": "DB connection pool", "gridPos": { "x": 0, "y": 35, "w": 24, "h": 1 } },
    {
      "type": "timeseries", "title": "Connections (active / pending)",
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "hikaricp_connections_active", "legendFormat": "{{application}} active" },
        { "refId": "B", "expr": "hikaricp_connections_pending", "legendFormat": "{{application}} pending" }
      ]
    },
    {
      "type": "timeseries", "title": "Mean connection wait",
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{
        "refId": "A",
        "expr": "sum by (application) (rate(hikaricp_connections_acquire_seconds_sum[$__rate_interval])) / sum by (application) (rate(hikaricp_connections_acquire_seconds_count[$__rate_interval]))",
        "legendFormat": "{{application}}"
      }]
    }
  ]
}
